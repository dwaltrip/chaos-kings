{
  "name": "generals-v2-backend",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "ts-node --watch src/server.ts",
    "build": "tsc && tsc-alias",
    "prod": "node dist/server.js",
    "start:prod": "ts-node -r tsconfig-paths/register src/server.ts",
    "test": "jest --silent --verbose=false --reporters=summary",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch --silent --verbose=false --reporters=summary",
    "migrate:latest": "kysely migrate latest",
    "migrate:up": "kysely migrate up",
    "migrate:down": "kysely migrate down",
    "clear:dev-db": "ts-node scripts/clear-dev-db.ts",
    "replay:verify": "ts-node -r tsconfig-paths/register scripts/replay-verify.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "kysely": "^0.28.2",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.1",
    "redis": "^5.5.6",
    "uuid": "^11.1.0",
    "ws": "^8.14.2",
    "tsconfig-paths": "^4.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3",
    "kysely-ctl": "^0.13.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.15.4",
    "@types/redis": "^4.0.10",
    "@types/ws": "^8.5.8"
  },
  "devDependencies": {
    "jest": "^30.0.5",
    "ts-jest": "^29.4.0",
    "tsc-alias": "^1.8.16"
  }
}
