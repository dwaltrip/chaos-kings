{
  "name": "generals-v2-backend",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "ts-node --watch src/server.ts",
    "dev:ws": "ts-node --watch src/websocket-server.ts",
    "build": "tsc && tsc-alias",
    "prod": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate:latest": "kysely migrate latest",
    "migrate:up": "kysely migrate up",
    "migrate:down": "kysely migrate down"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "kysely": "^0.28.2",
    "pg": "^8.16.3",
    "redis": "^5.5.6",
    "uuid": "^11.1.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.15.4",
    "@types/redis": "^4.0.10",
    "@types/ws": "^8.5.8",
    "jest": "^30.0.5",
    "kysely-ctl": "^0.13.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
