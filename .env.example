# Domain/email for HTTPS (used by Caddy)
DOMAIN=
ACME_EMAIL=

# Database (compose will inject into DATABASE_URL for the API)
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis (internal)
REDIS_URL=redis://redis:6379/0

# App
SESSION_SECRET=change_me
CORS_ORIGIN=

# Frontend dev-only overrides (not used in prod)
VITE_API_BASE_URL=
VITE_WS_URL=

