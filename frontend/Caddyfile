{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode zstd gzip

  # Ensure proxy routes run before SPA fallback
  handle /api* {
    reverse_proxy api:3131
  }

  handle /ws* {
    reverse_proxy api:3131
  }

  # SPA static files with index.html fallback
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
